# ==============================================================================
# InsightOS — environment configuration
# Copy to `.env` and adjust. EVERY value below has a working zero-cost default;
# the application boots and runs with this file copied verbatim.
# ==============================================================================

# ------------------------------------------------------------------------------
# Core
# ------------------------------------------------------------------------------
APP_ENV=development                     # development | production | test
LOG_LEVEL=INFO                          # DEBUG | INFO | WARNING | ERROR
API_PREFIX=/api/v1

# Signs InsightOS-issued tokens (local auth mode + scoped upload tokens).
# Generate with:  python -c "import secrets;print(secrets.token_urlsafe(48))"
APP_JWT_SECRET=dev-only-insecure-secret-change-me-in-production
ACCESS_TOKEN_TTL_SECONDS=3600
REFRESH_TOKEN_TTL_SECONDS=1209600
UPLOAD_TOKEN_TTL_SECONDS=300

# Comma-separated list of browser origins allowed to call the API directly.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ------------------------------------------------------------------------------
# Authentication
#   local    -> InsightOS issues its own JWTs, users live in the `users` table.
#               Needs NO external service. Default for local dev + CI.
#   supabase -> Auth is delegated to Supabase Auth (free tier).
# ------------------------------------------------------------------------------
AUTH_MODE=local

# ------------------------------------------------------------------------------
# Database
#   Local dev (docker compose):
#     postgresql+asyncpg://insightos:insightos@localhost:5432/insightos
#   Supabase (Project Settings -> Database -> Connection string -> URI):
#     postgresql+asyncpg://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
#   Zero-setup fallback (no server needed, used by tests):
#     sqlite+aiosqlite:///./.data/insightos.db
# ------------------------------------------------------------------------------
DATABASE_URL=sqlite+aiosqlite:///./.data/insightos.db
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5

# ------------------------------------------------------------------------------
# Supabase (only required when AUTH_MODE=supabase or STORAGE_BACKEND=supabase)
# All values come from the free tier. The service role key is BACKEND-ONLY —
# it must never be exposed to the browser.
# ------------------------------------------------------------------------------
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=
SUPABASE_STORAGE_BUCKET=datasets

# ------------------------------------------------------------------------------
# Object storage
#   local    -> files on disk under STORAGE_LOCAL_DIR (default, free)
#   supabase -> Supabase Storage free tier
# ------------------------------------------------------------------------------
STORAGE_BACKEND=local
STORAGE_LOCAL_DIR=./.data/storage

# ------------------------------------------------------------------------------
# AI layer — OPTIONAL BY DESIGN.
# Leave everything blank and InsightOS runs in deterministic mode: every
# analysis, KPI, chart, insight, anomaly, forecast and report still works.
#
#   AI_PROVIDER=auto     -> probe Ollama, then external, then deterministic
#   AI_PROVIDER=ollama   -> force local Ollama
#   AI_PROVIDER=external -> force the OpenAI-compatible endpoint below
#   AI_PROVIDER=none     -> force deterministic mode (no network calls at all)
# ------------------------------------------------------------------------------
AI_PROVIDER=auto
AI_REQUEST_TIMEOUT_SECONDS=60

OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b

# Any OpenAI-compatible endpoint the user chooses to configure themselves.
# Nothing here is required and nothing is enabled by default.
EXTERNAL_AI_BASE_URL=
EXTERNAL_AI_API_KEY=
EXTERNAL_AI_MODEL=

# Hard privacy switch: when true, dataset *values* are never placed in a prompt,
# only schema names and aggregated numbers.
AI_REDACT_SAMPLE_VALUES=false

# ------------------------------------------------------------------------------
# Free-tier guard rails (all configurable — raise them if your quota allows)
# ------------------------------------------------------------------------------
MAX_FILE_SIZE_MB=50
MAX_ROWS=250000
MAX_COLUMNS=512
MAX_DATASETS_PER_USER=10
MAX_REPORTS_PER_USER=20
MAX_ANALYSIS_HISTORY=100
MAX_CELL_LENGTH=32768
QUERY_TIMEOUT_SECONDS=20
SQL_ROW_LIMIT=5000

# ------------------------------------------------------------------------------
# Rate limiting (in-process token bucket — no Redis, no paid service)
# ------------------------------------------------------------------------------
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=120
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_UPLOAD_REQUESTS=10
RATE_LIMIT_AI_REQUESTS=30

# ------------------------------------------------------------------------------
# Demo mode (public, no login, read-only)
# ------------------------------------------------------------------------------
DEMO_ENABLED=true
DEMO_ROWS=120000
DEMO_SEED=20260101

# ==============================================================================
# FRONTEND (frontend/.env.local) — see frontend/.env.example
# ==============================================================================
# NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
# API_BASE_URL=http://localhost:8000
# NEXT_PUBLIC_APP_NAME=InsightOS
